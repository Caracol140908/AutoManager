// AutoManager — ER académico (núcleo operacional)
// Colar em https://dbdiagram.io/d

Project AutoManager_Core {
  database_type: 'MySQL'
  Note: '''
    Modelo ER simplificado — fluxo principal da oficina.
    Cliente regista veículo → marca serviço → orçamentista define linhas
    → mecânico executa a reparação.
  '''
}

// ─────────────────────────────────────────
// ENTIDADES
// ─────────────────────────────────────────

Table utilizador {
  id_utilizador int [pk, increment, note: 'Cliente registado no sistema']
  nome_utilizador varchar(100) [not null]
  email varchar(150) [unique, not null]
  telefone varchar(30)
  nif varchar(20)
  bloqueado tinyint [default: 0, note: '0=ativo 1=bloqueado']
  created_at timestamp

  Note: 'Utilizador / cliente final'
}

Table carro {
  id_carro int [pk, increment]
  id_utilizador int [not null, ref: > utilizador.id_utilizador]
  marca varchar(60) [not null]
  modelo varchar(80)
  matricula varchar(20) [not null]
  ano int
  is_principal tinyint [default: 0, note: 'Veículo predefinido do cliente']

  Note: 'Veículo associado a um cliente (1 cliente : N carros)'
}

Table servico {
  id int [pk, increment, note: 'Marcação / reparação']
  id_utilizador int [ref: > utilizador.id_utilizador, note: 'Cliente (pode ser NULL se visitante)']
  mecanico_id int [ref: > mecanicos.id_mecanico, note: 'Mecânico atribuído']
  matricula varchar(20) [note: 'Veículo da intervenção']
  tipo_servico varchar(255) [not null]
  data_desejada date
  estado_do_trabalho varchar(50) [note: 'Por Fazer | Em Andamento | Pronto']
  estado_orcamento varchar(30) [note: 'Pendente | Aprovado | Recusado']
  estado_pagamento varchar(20) [note: 'Pendente | Pago']
  custo decimal(10,2)
  created_at timestamp

  Note: 'Serviço / marcação — entidade central do sistema'
}

Table servico_orcamento_item {
  id int [pk, increment]
  servico_id int [not null, ref: > servico.id]
  descricao varchar(500) [not null]
  categoria varchar(24) [note: 'peca | mao_obra | outro']
  quantidade decimal(10,3) [default: 1]
  preco_unitario decimal(10,2) [default: 0]
  decisao_cliente varchar(20) [default: 'aceite', note: 'aceite | recusado']

  Note: 'Linha do orçamento (1 serviço : N linhas)'
}

Table mecanicos {
  id_mecanico int [pk, increment]
  nome_mecanico varchar(100) [not null]
  email varchar(100) [unique, not null]
  especialidade varchar(100)
  ativo tinyint [default: 1]

  Note: 'Mecânico da oficina (1 mecânico : N serviços)'
}

// ─────────────────────────────────────────
// RELAÇÕES (documentação académica)
// ─────────────────────────────────────────

// utilizador  1 ──── N  carro
// utilizador  1 ──── N  servico
// mecanicos   1 ──── N  servico
// servico     1 ──── N  servico_orcamento_item
//
// Ligação lógica servico ↔ carro: por matricula (não há FK directa na BD)
