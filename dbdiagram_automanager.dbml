// ══════════════════════════════════════════════════════════════
// AutoManager — colar em https://dbdiagram.io/d
// Ficheiro pronto: copiar TUDO e colar no editor à esquerda
// ══════════════════════════════════════════════════════════════

Project AutoManager {
  database_type: 'MySQL'
  Note: '''
    ## Núcleo operacional AutoManager
    Cliente (utilizador) → veículo (carro) → marcação (servico)
    → linhas de orçamento (servico_orcamento_item) → mecânico (mecanicos)
  '''
}

TableGroup nucleo {
  utilizador
  carro
  mecanicos
  servico
  servico_orcamento_item
}

// ── CLIENTE ──────────────────────────────────────────────────

Table utilizador {
  id_utilizador int [pk, increment]
  nome_utilizador varchar(100) [not null]
  email varchar(150) [unique, not null]
  telefone varchar(30)
  nif varchar(20)
  bloqueado tinyint [default: 0]
  created_at timestamp

  Note: 'Cliente registado na plataforma'
}

// ── VEÍCULO ──────────────────────────────────────────────────

Table carro {
  id_carro int [pk, increment]
  id_utilizador int [not null]
  marca varchar(60) [not null]
  modelo varchar(80)
  matricula varchar(20) [not null]
  ano int
  is_principal tinyint [default: 0]

  Note: 'Veículos do cliente — relação 1:N com utilizador'
}

// ── EQUIPA ───────────────────────────────────────────────────

Table mecanicos {
  id_mecanico int [pk, increment]
  nome_mecanico varchar(100) [not null]
  email varchar(100) [unique, not null]
  especialidade varchar(100)
  ativo tinyint [default: 1]

  Note: 'Mecânico que executa o serviço — relação 1:N com servico'
}

// ── SERVIÇO (entidade central) ───────────────────────────────

Table servico {
  id int [pk, increment]
  id_utilizador int
  mecanico_id int
  matricula varchar(20) [note: 'Ligação lógica ao carro']
  tipo_servico varchar(255) [not null]
  data_desejada date
  estado_do_trabalho varchar(50) [note: 'Por Fazer | Em Andamento | Pronto']
  estado_orcamento varchar(30)
  estado_pagamento varchar(20)
  custo decimal(10,2)
  created_at timestamp

  Note: 'Marcação / reparação — HUB do sistema'
}

// ── ORÇAMENTO (linhas) ───────────────────────────────────────

Table servico_orcamento_item {
  id int [pk, increment]
  servico_id int [not null]
  descricao varchar(500) [not null]
  categoria varchar(24) [note: 'peca | mao_obra | outro']
  quantidade decimal(10,3) [default: 1]
  preco_unitario decimal(10,2) [default: 0]
  decisao_cliente varchar(20) [default: 'aceite']

  Note: 'Linhas do orçamento — relação 1:N com servico'
}

// ── RELACIONAMENTOS ──────────────────────────────────────────

Ref: carro.id_utilizador > utilizador.id_utilizador           // 1:N possui
Ref: servico.id_utilizador > utilizador.id_utilizador         // 1:N solicita
Ref: servico.mecanico_id > mecanicos.id_mecanico              // 1:N executa
Ref: servico_orcamento_item.servico_id > servico.id           // 1:N contém

// Ligação lógica (sem FK): servico.matricula ≈ carro.matricula
